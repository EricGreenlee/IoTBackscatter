- name: Decoder_0_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\nSTATE_SEARCH = 0\nSTATE_HEADER = 1\nSTATE_DATA =\
      \ 2\n\ntype Bit = int\ntype Symbol = list[Bit]\n\nclass blk(gr.basic_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n\n    #\
      \ only default arguments here\n    def __init__(self, data_bits=8, parity_bits=4,\
      \ code_repetitions=5,\n                 min_valid_repetitions=2):\n        \"\
      \"\"arguments to this function show up as parameters in GRC\"\"\"\n        gr.basic_block.__init__(\n\
      \            self,\n            name='Decoder with Threshold',   # will show\
      \ up in GRC\n            in_sig=[np.byte],\n            out_sig=[np.byte, np.float32],\n\
      \        )\n\n        # if an attribute with the same name as a parameter is\
      \ found,\n        # a callback is registered (properties work, too).\n     \
      \   self.data_bits = data_bits\n        self.parity_bits = parity_bits\n   \
      \     self.code_repetitions = code_repetitions\n        self.min_valid_repetitions\
      \ = min_valid_repetitions\n\n        if self.data_bits > 8:\n            raise\
      \ Exception(\"max allowed data bits is 8\")\n\n        if self.data_bits % self.parity_bits\
      \ != 0:\n            raise Exception(\"data_bits mod parity_bits must equal\
      \ 0\")\n\n        if self.min_valid_repetitions > self.code_repetitions:\n \
      \           raise Exception(\"cannot have higher min valid repetitons than number\
      \ of repetitions\")\n\n        self.code_symbol_bits = self.data_bits + self.parity_bits\n\
      \        self.code_group_len = self.code_symbol_bits * self.code_repetitions\n\
      \        self.raw_bits = []\n        self.low_confidence_counter = 0\n\n   \
      \ def general_work(self, input_items, output_items):\n        added = 0\n  \
      \      to_consume = min(len(input_items[0]), len(output_items[0]))\n\n     \
      \   for i in range(to_consume):\n            bit = input_items[0][i]\n     \
      \       # self.raw_bits.append(1 if bit == np.int8(1) else 0)\n            self.raw_bits.append(bit)\n\
      \n            if len(self.raw_bits) == self.code_group_len:\n              \
      \  # if self.raw_bits != [0,0,0,0,1,0,1,0,1,0,1,0,0,0,0,0,1,0,1,0,1,0,1,0,0,0,0,0,1,0,1,0,1,0,1,0,0,0,0,0,1,0,1,0,1,0,1,0,0,0,0,0,1,0,1,0,1,0,1,0]:\n\
      \                #     raise Exception(f'bad raw bits: {self.raw_bits}')\n\n\
      \                decoded = self.decode(self.raw_bits)\n                # if\
      \ decoded != [0,0,0,0,1,0,1,0]:\n                #     raise Exception(f'bad\
      \ decoded: {decoded}')\n\n                data_byte = 0\n                if\
      \ decoded:\n                    data_byte = self.bits_to_int(decoded)\n\n  \
      \              # if data_byte != 10:\n                #     raise Exception(f'bad\
      \ data byte: {data_byte}')\n\n                output_items[0][added] = data_byte\n\
      \                output_items[1][added] = self.calc_ber(self.raw_bits, data_byte)\
      \ if decoded else 1.0\n                added += 1\n\n                self.raw_bits\
      \ = []\n\n        self.consume_each(to_consume)\n        return added\n\n\n\
      \    def decode(self, bits: list[Bit]) -> list[Bit] | None:\n        symbol_repetitions\
      \ = [bits[self.code_symbol_bits*r:self.code_symbol_bits*(r+1)]\n           \
      \                     for r in range(self.code_repetitions)]\n        valid_repetitions\
      \ = [s for s in symbol_repetitions if self.is_valid(s)]\n        counts = {}\n\
      \        best_count = 0\n        best_data = None\n        for symbol in valid_repetitions:\n\
      \            data = symbol[0:self.data_bits]\n            key = self.bits_to_key(data)\n\
      \            if not key in counts:\n                counts[key] = 0\n      \
      \      counts[key] += 1\n            if counts[key] > best_count:\n        \
      \        best_count = counts[key]\n                best_data = data\n\n    \
      \    return best_data if best_count >= self.min_valid_repetitions else None\n\
      \n\n    # validate parity bits\n    def is_valid(self, symbol: Symbol) -> bool:\n\
      \        data = symbol[0:self.data_bits]\n        checksum = [False for _ in\
      \ range(self.parity_bits)]\n        for offset in range(0, self.data_bits, self.parity_bits):\n\
      \            checksum = [checksum[i] ^ data[offset+i] for i in range(self.parity_bits)]\n\
      \n        return checksum == symbol[self.data_bits:]\n\n\n    # create a unique\
      \ key corresponding to the given bits\n    def bits_to_key(self, bits: list[Bit])\
      \ -> int:\n        k = 0\n        for i in range(len(bits)):\n            k\
      \ = k | (bits[i] << i)\n        return k\n\n    def bits_to_int(self, bits:\
      \ list[Bit]) -> int:\n        val = 0\n        for i in range(len(bits)):\n\
      \            val = val | (bits[i] << (len(bits) - i - 1))\n        return val\n\
      \n    def int_to_bits(self, val: int) -> list[Bit]:\n        return [(val >>\
      \ (self.data_bits - i - 1)) & 0x1 for i in range(self.data_bits)]\n\n    def\
      \ encode(self, val: int) -> list[Bit]:\n        val_bits = self.int_to_bits(val)\n\
      \        checksum = [0 for _ in range(self.parity_bits)]\n        for offset\
      \ in range(0, self.data_bits, self.parity_bits):\n            checksum = [checksum[i]\
      \ ^ val_bits[offset+i] for i in range(self.parity_bits)]\n\n        symbol =\
      \ val_bits + checksum\n        return symbol * self.code_repetitions\n\n   \
      \ def calc_ber(self, bits: list[Bit], expected_val: int) -> float:\n       \
      \ encoded = self.encode(expected_val)\n        if len(bits) != len(encoded):\n\
      \            raise Exception(f\"Incorrect number of bits. Expected {len(encoded)},\
      \ got {len(bits)}.\")\n\n        bit_errors = sum([0 if bits[i] == encoded[i]\
      \ else 1 for i in range(len(bits))])\n        return bit_errors / len(bits)\n"
    affinity: ''
    alias: ''
    code_repetitions: repetitions
    comment: ''
    data_bits: data_bits
    maxoutbuf: '0'
    min_valid_repetitions: '2'
    minoutbuf: '0'
    parity_bits: parity_bits
  states:
    _io_cache: ('Decoder with Threshold', 'blk', [('data_bits', '8'), ('parity_bits',
      '4'), ('code_repetitions', '5'), ('min_valid_repetitions', '2')], [('0', 'byte',
      1)], [('0', 'byte', 1), ('1', 'float', 1)], 'arguments to this function show
      up as parameters in GRC', ['code_repetitions', 'data_bits', 'min_valid_repetitions',
      'parity_bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 1176.0]
    rotation: 0
    state: disabled
