- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\nimport time\n\n\n\n\n#class blk(gr.sync_block):  #\
      \ other base classes are basic_block, decim_block, interp_block\nclass blk(gr.basic_block):\n\
      \    #\"\"\"Embedded Python Block example - a simple multiply const\"\"\"\n\n\
      \    def __init__(self, example_param=1.0):  # only default arguments here\n\
      \        \"\"\"arguments to this function show up as parameters in GRC\"\"\"\
      \n        gr.basic_block.__init__(\n            self,\n            name='Decoder\
      \ v2',   # will show up in GRC\n            in_sig=[np.byte],\n            out_sig=[np.byte,np.complex64]\n\
      \        )\n        # if an attribute with the same name as a parameter is found,\n\
      \        # a callback is registered (properties work, too).\n        self.example_param\
      \ = example_param\n\n\tself.raw_bits = []\n\n    def general_work(self, input_items,\
      \ output_items):\n\n\t#print(len(input_items[0]))\n\t#print(len(output_items[0]))\n\
      \n\tadded = 0\n\tto_consume = min(len(input_items[0]), len(output_items[0]))\n\
      \n\tfor i in range(to_consume):\n\t    bit = input_items[0][i]\n\t    self.raw_bits.append(bit)\n\
      \n\t    if len(self.raw_bits) == 15*8:\n\t\t#decoded = self.decode(self.raw_bits)\n\
      \t\tdecoded = self.decode_simple(self.raw_bits)\n\t\tself.raw_bites = []\n\t\
      \t#if not decoded:\n\t\t    #continue\n\n\t\toutput_items[0][:] = decoded\n\n\
      \t\t#count = 0\n\t\t#for b in decoded:\n\t\t    #if (count < 6):\n\t\t\t#output_items[0][added]\
      \ = np.byte(b)\n\n\n        #output_items[0][:] = input_items[0] \n\toutput_items[1][:]\
      \ = time.time()-1700000000\n\n\tself.consume_each(to_consume)\n        #return\
      \ len(output_items[0])\n\treturn added\n\n    def decode_simple(self, bits):\n\
      \tprint(bits)\n\t#print\n\tbit_array = np.empty((15,8))\n\tdecoded_array = np.empty((15,1))\n\
      \tprint(bit_array)\n\tfor i in range(15):\n\t    for j in range(8):\n\t\tindex\
      \ = j+i*8\n\t\t#print(index)\n\t\tbit_array[i][j] = bits[index]\n\t    print(bit_array[i])\n\
      \t    print(self.is_valid(bit_array[i]))\n\tprint(bit_array)\n\t\n\t\n\n\treturn\
      \ 10\n\n    def decode(self, bits):\n        bit_repetitions = [[bits[2*r+b]\
      \ for r in range(15)] for b in range(120)]\n        symbol = [self.decode_bit(b)\
      \ for b in bit_repetitions]\n        if self.is_valid(symbol):\n\t    #self.last_valid_time\
      \ = time.time()\n            return bits\n\n        return None\n\n    def decode_bit(self,\
      \ repetitions):\n        count0 = len([b for b in repetitions if b == 0])\n\
      \        #if count0 > self.code_repetitions / 2.0:\n        #    return 0\n\
      \        #if count0 < self.code_repetitions / 2.0:\n        #    return 1\n\n\
      \tif count0 >= self.threshold:\n\t    return 0\n\tif count0 <= self.code_repetitions\
      \ - self.threshold:\n\t    return 1\n\treturn None\n\n    def is_valid(self,\
      \ symbol):\n\tprint(symbol)\n\tprint(symbol[0:6])\n        data = symbol[0:6]\n\
      \        checksum = [0 for _ in range(2)]\n\tfor i in range(0,6):\n\t    if\
      \ data[i] == None:\n\t\treturn False\n\n        for offset in range(0, 6,2):\n\
      \            checksum = [checksum[i] ^ data[offset+i] for i in range(2)]\n\n\
      \        return checksum == symbol[6:]\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 872.0]
    rotation: 0
    state: disabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.basic_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, max_valid_val=0):\
      \  # only default arguments here\n        \"\"\"arguments to this function show\
      \ up as parameters in GRC\"\"\"\n        gr.basic_block.__init__(\n        \
      \    self,\n            name='Data Filter',   # will show up in GRC\n      \
      \      in_sig=[np.byte, np.byte],\n            out_sig=[np.byte]\n        )\n\
      \        # if an attribute with the same name as a parameter is found,\n   \
      \     # a callback is registered (properties work, too).\n        self.max_valid_val\
      \ = max_valid_val\n\n    def general_work(self, input_items, output_items):\n\
      \        added = 0\n        to_consume = min(len(input_items[0]), len(output_items[0]))\n\
      \n        for i in range(to_consume):\n            bit = input_items[0][i]\n\
      \            val = input_items[1][i]\n            if val <= self.max_valid_val:\n\
      \                output_items[0][added] = bit\n                added += 1\n\n\
      \        self.consume_each(to_consume)\n        return added\n"
    affinity: ''
    alias: ''
    comment: ''
    max_valid_val: max_preamble_err_bits
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Data Filter', 'blk', [('max_valid_val', '0')], [('0', 'byte', 1),
      ('1', 'byte', 1)], [('0', 'byte', 1)], 'Embedded Python Block example - a simple
      multiply const', ['max_valid_val'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1192.0]
    rotation: 0
    state: disabled
