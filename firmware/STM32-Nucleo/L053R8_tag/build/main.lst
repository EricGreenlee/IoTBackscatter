  95:Core/Src/main.c ****   MX_DAC_Init();
  96:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
  97:Core/Src/main.c **** 
  98:Core/Src/main.c ****   // Send startup message
  99:Core/Src/main.c ****   char msg[] = "LED Blink with UART and DAC Started!\r\n";
 100:Core/Src/main.c ****   HAL_UART_Transmit(&huart2, (uint8_t *)msg, sizeof(msg) - 1, HAL_MAX_DELAY);
 101:Core/Src/main.c **** 
 102:Core/Src/main.c ****   // Start DAC and set to 1.65V (mid-range voltage)
 103:Core/Src/main.c ****   HAL_DAC_Start(&hdac, DAC_CHANNEL_1);
 104:Core/Src/main.c ****   HAL_DAC_SetValue(&hdac, DAC_CHANNEL_1, DAC_ALIGN_12B_R, 2048); // 2048 = 50% of 4096 = 1.65V
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****   char dac_msg[] = "DAC started - 1.65V constant output on PA4\r\n";
 107:Core/Src/main.c ****   HAL_UART_Transmit(&huart2, (uint8_t *)dac_msg, sizeof(dac_msg) - 1, HAL_MAX_DELAY);
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****   static uint8_t square_state = 0;
 110:Core/Src/main.c ****   /* USER CODE END 2 */
 111:Core/Src/main.c **** 
 112:Core/Src/main.c ****   /* Infinite loop */
 113:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 114:Core/Src/main.c ****   while (1)
 115:Core/Src/main.c ****   {
 116:Core/Src/main.c ****     /* USER CODE END WHILE */
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 119:Core/Src/main.c ****     HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
 120:Core/Src/main.c **** 
 121:Core/Src/main.c ****     // Send LED status messages
 122:Core/Src/main.c ****     char led_msg[] = "LED Toggle\r\n";
 123:Core/Src/main.c ****     HAL_UART_Transmit(&huart2, (uint8_t *)led_msg, sizeof(led_msg) - 1, HAL_MAX_DELAY);
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****     if (square_state == 0)
 126:Core/Src/main.c ****     {
 127:Core/Src/main.c ****       HAL_DAC_SetValue(&hdac, DAC_CHANNEL_1, DAC_ALIGN_12B_R, 600); // ~0.5V
 128:Core/Src/main.c ****       char low_msg[] = "Square LOW (0.5V)\r\n";
 129:Core/Src/main.c ****       HAL_UART_Transmit(&huart2, (uint8_t *)low_msg, sizeof(low_msg) - 1, HAL_MAX_DELAY);
 130:Core/Src/main.c ****       square_state = 1;
 131:Core/Src/main.c ****     }
 132:Core/Src/main.c ****     else
 133:Core/Src/main.c ****     {
 134:Core/Src/main.c ****       HAL_DAC_SetValue(&hdac, DAC_CHANNEL_1, DAC_ALIGN_12B_R, 3500); // ~2.8V
 135:Core/Src/main.c ****       char high_msg[] = "Square HIGH (2.8V)\r\n";
 136:Core/Src/main.c ****       HAL_UART_Transmit(&huart2, (uint8_t *)high_msg, sizeof(high_msg) - 1, HAL_MAX_DELAY);
 137:Core/Src/main.c ****       square_state = 0;
 138:Core/Src/main.c ****     }
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****     HAL_Delay(2000);
 141:Core/Src/main.c ****   }
 142:Core/Src/main.c ****   /* USER CODE END 3 */
 143:Core/Src/main.c **** }
